<view class="page data-v-65371a1e"><view class="hero data-v-65371a1e"><text class="title data-v-65371a1e">今天吃什么</text><text class="subtitle data-v-65371a1e">点一下转盘，让它帮你做决定</text></view><view class="wheel-panel data-v-65371a1e"><view class="pointer data-v-65371a1e"></view><view data-event-opts="{{[['tap',[['startSpin',['$event']]]]]}}" class="wheel-wrap data-v-65371a1e" bindtap="__e"><view class="wheel data-v-65371a1e" style="{{(wheelStyle)}}"><block wx:for="{{dividers}}" wx:for-item="item" wx:for-index="__i0__" wx:key="key"><view class="divider data-v-65371a1e" style="{{(item.style)}}"></view></block><block wx:for="{{labels}}" wx:for-item="item" wx:for-index="__i1__" wx:key="name"><view class="label data-v-65371a1e" style="{{(item.style)}}"><text style="{{(item.textStyle)}}" class="data-v-65371a1e">{{item.name}}</text></view></block></view><view class="center-button data-v-65371a1e"><text class="center-main data-v-65371a1e">{{spinning?'转动中':'开始'}}</text><text class="center-sub data-v-65371a1e">{{spinning?'请稍候':'点击转盘'}}</text></view></view></view><view class="action-row data-v-65371a1e"><view data-event-opts="{{[['tap',[['startSpin',['$event']]]]]}}" class="primary-button data-v-65371a1e" bindtap="__e"><text class="data-v-65371a1e">{{spinning?'转盘转动中...':'再摇一次'}}</text></view></view><view class="result-card data-v-65371a1e"><text class="result-label data-v-65371a1e">上次抽中</text><text class="result-value data-v-65371a1e">{{lastResult||'还没决定好，先转一下吧'}}</text></view><view class="foods-card data-v-65371a1e"><text class="foods-title data-v-65371a1e">今日候选菜单</text><view class="foods-list data-v-65371a1e"><block wx:for="{{foods}}" wx:for-item="food" wx:for-index="__i2__" wx:key="*this"><text class="food-tag data-v-65371a1e">{{food}}</text></block></view></view></view>